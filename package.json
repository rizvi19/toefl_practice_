{
  "name": "toefl-practice-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TOEFL 2026 independent adaptive section tests and preserved practice library",
  "scripts": {
    "validate": "node tools/validate-collection.mjs",
    "smoke": "node tools/smoke-playwright.mjs",
    "build:bank": "node tools/build-exam-bank.mjs",
    "test:sections": "node --test tests/section-core.test.mjs",
    "test:browser": "node tests/section-browser.mjs && node tests/section-audio.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
